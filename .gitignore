# Données propres à chaque installation (créées par scripts/install.sh depuis les exemples, jamais écrasées)
workspace/state/*.json
!workspace/state/*.json.example
workspace/learning/*.md
!workspace/learning/.templates/
workspace/MEMORY.md
workspace/templates/_tokens.json
workspace/templates/_brand/*
!workspace/templates/_brand/README.md
workspace/outbox/*
!workspace/outbox/.gitkeep
workspace/export/
workspace/memory/*
!workspace/memory/.gitkeep
# Divers
*.tmp
*.bak-*
__pycache__/
node_modules/
.DS_Store
# Secrets : jamais
*.env
.env*
!config/env.example
