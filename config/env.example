# Variables d'environnement lues par le gateway OpenClaw pour Novia Com.
# À placer dans le fichier d'environnement du service OpenClaw (voir docs/INSTALLATION.md, étape 4),
# JAMAIS dans le dépôt. Laisser vide ce qui n'est pas encore branché : l'agent le signalera par son nom.

# Telegram : jeton du bot « Novia Com » créé avec @BotFather
NOVIA_TELEGRAM_BOT_TOKEN=

# Publication (choisir un connecteur au moins ; voir connectors/README.md)
UPLOAD_POST_API_KEY=
META_PAGE_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
BREVO_API_KEY=

# Optionnel, skills partagés (voir skills-shared/INSTALL.md)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
